#include <iostream>
#include <vector>
#include <utility>
#include <algorithm>

using namespace std;

int main() {

	ios::sync_with_stdio(false);
	cin.tie(NULL);
	cout.tie(NULL);

	int N;
	cin >> N;

	vector<pair<int, int>> meeting(N);

	for (int i = 0; i < N; i++) {

		cin >> meeting[i].first >> meeting[i].second;

	}

	sort(meeting.begin(), meeting.end(), [](auto& a, auto& b) {

		if (a.second == b.second) return a.first < b.first;
		return a.second < b.second;

	});

	int count = 0;
	int last_end = 0;

	for (auto& m : meeting) {

		if (m.first >= last_end) {

			count++;
			last_end = m.second;

		}

	}

	cout << count << endl;

	return 0;

}
